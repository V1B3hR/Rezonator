       IDENTIFICATION DIVISION.
       PROGRAM-ID. BATCH-INTEREST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PRINCIPAL          PIC 9(8)V99 VALUE 250000.00.
       01 WS-ANNUAL-RATE        PIC 9(2)V99 VALUE 05.50.
       01 WS-MONTHS-ACTIVE      PIC 9(03)   VALUE 036.
       01 WS-MONTHLY-RATE       PIC 9(2)V6  VALUE 0.000000.
       01 WS-COMPOUND-INTEREST  PIC 9(8)V99 VALUE 0.00.
       01 WS-TOTAL-ACCRUAL      PIC 9(8)V99 VALUE 0.00.
       01 WS-TAX-WITHHELD       PIC 9(6)V99 VALUE 0.00.
       01 WS-NET-PAYOUT         PIC 9(8)V99 VALUE 0.00.

       PROCEDURE DIVISION.
       0000-PROCESS-BATCH.
           PERFORM 1000-CALC-RATES.
           PERFORM 2000-COMPOUND-LOOP.
           PERFORM 3000-DEDUCT-TAXES.
           PERFORM 4000-FINALIZE-LEDGER.
           STOP RUN.

       1000-CALC-RATES.
           COMPUTE WS-MONTHLY-RATE = WS-ANNUAL-RATE / 1200.

       2000-COMPOUND-LOOP.
           COMPUTE WS-TOTAL-ACCRUAL = WS-PRINCIPAL +
               WS-PRINCIPAL * WS-MONTHLY-RATE.
           COMPUTE WS-COMPOUND-INTEREST =
               WS-TOTAL-ACCRUAL - WS-PRINCIPAL.

       3000-DEDUCT-TAXES.
           COMPUTE WS-TAX-WITHHELD = WS-COMPOUND-INTEREST * 0.19.

       4000-FINALIZE-LEDGER.
           COMPUTE WS-NET-PAYOUT = WS-TOTAL-ACCRUAL - WS-TAX-WITHHELD.
