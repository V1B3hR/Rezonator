       IDENTIFICATION DIVISION.
       PROGRAM-ID. TAX-WITHHOLDING.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-GROSS-INCOME       PIC 9(7)V99 VALUE 0085000.00.
       01 WS-TAX-CREDITS        PIC 9(5)V99 VALUE 02000.00.
       01 WS-TAXABLE-BASE       PIC 9(7)V99 VALUE 0.00.
       01 WS-TIER1-TAX          PIC 9(6)V99 VALUE 0.00.
       01 WS-TIER2-TAX          PIC 9(6)V99 VALUE 0.00.
       01 WS-TOTAL-TAX          PIC 9(6)V99 VALUE 0.00.
       01 WS-NET-WITHHELD       PIC 9(6)V99 VALUE 0.00.

       PROCEDURE DIVISION.
       0000-CALC-TAX.
           PERFORM 1000-ADJUST-BASE.
           IF WS-TAXABLE-BASE > 50000.00
               PERFORM 2000-CALC-TIER2
           ELSE
               PERFORM 3000-CALC-TIER1
           END-IF.
           PERFORM 4000-FINALIZE-WITHHOLDING.
           STOP RUN.

       1000-ADJUST-BASE.
           SUBTRACT WS-TAX-CREDITS FROM WS-GROSS-INCOME
               GIVING WS-TAXABLE-BASE.

       2000-CALC-TIER2.
           COMPUTE WS-TIER1-TAX = 50000.00 * 0.12.
           COMPUTE WS-TIER2-TAX =
               (WS-TAXABLE-BASE - 50000.00) * 0.22.
           COMPUTE WS-TOTAL-TAX = WS-TIER1-TAX + WS-TIER2-TAX.

       3000-CALC-TIER1.
           COMPUTE WS-TIER1-TAX = WS-TAXABLE-BASE * 0.12.
           MOVE 0.00 TO WS-TIER2-TAX.
           MOVE WS-TIER1-TAX TO WS-TOTAL-TAX.

       4000-FINALIZE-WITHHOLDING.
           COMPUTE WS-NET-WITHHELD = WS-TOTAL-TAX.
