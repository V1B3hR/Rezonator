       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOAN-AMORTIZATION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PRINCIPAL-AMT      PIC 9(7)V99 VALUE 100000.00.
       01 WS-INTEREST-RATE      PIC 9(2)V99 VALUE 06.00.
       01 WS-TERM-MONTHS        PIC 9(03)   VALUE 120.
       01 WS-MONTHLY-INTEREST   PIC 9(5)V99 VALUE 0.00.
       01 WS-PRINCIPAL-PAID     PIC 9(5)V99 VALUE 0.00.
       01 WS-INSURANCE-FEE      PIC 9(4)V99 VALUE 0.00.
       01 WS-TOTAL-PAYMENT      PIC 9(6)V99 VALUE 0.00.
       01 WS-REMAINING-BALANCE  PIC 9(7)V99 VALUE 0.00.
       01 WS-APPROVAL-STATUS    PIC X(04)   VALUE "PEND".

       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 1000-CHECK-ELIGIBILITY.
           IF WS-APPROVAL-STATUS = "OKAY"
               PERFORM 2000-CALC-INTEREST
               PERFORM 3000-CALC-INSURANCE
               PERFORM 4000-CALC-TOTAL
           ELSE
               PERFORM 5000-REJECT-LOAN
           END-IF.
           STOP RUN.

       1000-CHECK-ELIGIBILITY.
           IF WS-PRINCIPAL-AMT > 500000.00
               MOVE "REJT" TO WS-APPROVAL-STATUS
           ELSE
               MOVE "OKAY" TO WS-APPROVAL-STATUS
           END-IF.

       2000-CALC-INTEREST.
           COMPUTE WS-MONTHLY-INTEREST =
               WS-PRINCIPAL-AMT * WS-INTEREST-RATE / 1200.
           COMPUTE WS-PRINCIPAL-PAID =
               WS-PRINCIPAL-AMT / WS-TERM-MONTHS.

       3000-CALC-INSURANCE.
           COMPUTE WS-INSURANCE-FEE = WS-PRINCIPAL-AMT * 0.0015.

       4000-CALC-TOTAL.
           COMPUTE WS-TOTAL-PAYMENT = WS-PRINCIPAL-PAID +
               WS-MONTHLY-INTEREST + WS-INSURANCE-FEE.
           SUBTRACT WS-PRINCIPAL-PAID FROM WS-PRINCIPAL-AMT
               GIVING WS-REMAINING-BALANCE.

       5000-REJECT-LOAN.
           MOVE 0.00 TO WS-TOTAL-PAYMENT.
           MOVE "FAIL" TO WS-APPROVAL-STATUS.
