       IDENTIFICATION DIVISION.
       PROGRAM-ID. INSURANCE-CLAIM.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CLAIM-AMOUNT       PIC 9(6)V99 VALUE 012000.00.
       01 WS-DEDUCTIBLE         PIC 9(4)V99 VALUE 01000.00.
       01 WS-COPAY-PERCENT      PIC 9(1)V2  VALUE 0.20.
       01 WS-MAX-OUT-OF-POCKET  PIC 9(5)V99 VALUE 02500.00.
       01 WS-POLICY-ACTIVE      PIC X(01)   VALUE "Y".
       01 WS-ADMISSIBLE-AMOUNT  PIC 9(6)V99 VALUE 0.00.
       01 WS-PATIENT-COPAY      PIC 9(5)V99 VALUE 0.00.
       01 WS-PATIENT-TOTAL      PIC 9(5)V99 VALUE 0.00.
       01 WS-INSURER-PAYOUT     PIC 9(6)V99 VALUE 0.00.
       01 WS-CLAIM-STATUS       PIC X(04)   VALUE "PEND".

       PROCEDURE DIVISION.
       0000-ADJUDICATE-CLAIM.
           PERFORM 1000-VERIFY-POLICY.
           IF WS-CLAIM-STATUS = "OKAY"
               PERFORM 2000-CALC-DEDUCTIBLE
               PERFORM 3000-CALC-COPAY
               PERFORM 4000-FINALIZE-CLAIM
           ELSE
               PERFORM 5000-DENY-CLAIM
           END-IF.
           STOP RUN.

       1000-VERIFY-POLICY.
           IF WS-POLICY-ACTIVE = "Y"
               MOVE "OKAY" TO WS-CLAIM-STATUS
           ELSE
               MOVE "DENY" TO WS-CLAIM-STATUS
           END-IF.

       2000-CALC-DEDUCTIBLE.
           SUBTRACT WS-DEDUCTIBLE FROM WS-CLAIM-AMOUNT
               GIVING WS-ADMISSIBLE-AMOUNT.

       3000-CALC-COPAY.
           COMPUTE WS-PATIENT-COPAY =
               WS-ADMISSIBLE-AMOUNT * WS-COPAY-PERCENT.
           COMPUTE WS-PATIENT-TOTAL =
               WS-DEDUCTIBLE + WS-PATIENT-COPAY.
           IF WS-PATIENT-TOTAL > WS-MAX-OUT-OF-POCKET
               MOVE WS-MAX-OUT-OF-POCKET TO WS-PATIENT-TOTAL
           END-IF.

       4000-FINALIZE-CLAIM.
           SUBTRACT WS-PATIENT-TOTAL FROM WS-CLAIM-AMOUNT
               GIVING WS-INSURER-PAYOUT.

       5000-DENY-CLAIM.
           MOVE 0.00 TO WS-INSURER-PAYOUT.
           MOVE 0.00 TO WS-PATIENT-TOTAL.
