       IDENTIFICATION DIVISION.
       PROGRAM-ID. CURRENCY-EXCHANGE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SOURCE-AMT         PIC 9(6)V99 VALUE 005000.00.
       01 WS-FX-RATE            PIC 9(2)V6  VALUE 01.085000.
       01 WS-SPREAD-PCT         PIC 9(1)V4  VALUE 0.0120.
       01 WS-COMMISSION-MIN     PIC 9(3)V99 VALUE 015.00.
       01 WS-GROSS-CONVERTED    PIC 9(7)V99 VALUE 0.00.
       01 WS-SPREAD-FEE         PIC 9(5)V99 VALUE 0.00.
       01 WS-COMMISSION-FEE     PIC 9(5)V99 VALUE 0.00.
       01 WS-NET-DELIVERED      PIC 9(7)V99 VALUE 0.00.

       PROCEDURE DIVISION.
       0000-MAIN-FX.
           PERFORM 1000-CONVERT-BASE.
           PERFORM 2000-APPLY-SPREAD.
           PERFORM 3000-CALC-COMMISSION.
           PERFORM 4000-FINALIZE-ORDER.
           STOP RUN.

       1000-CONVERT-BASE.
           COMPUTE WS-GROSS-CONVERTED = WS-SOURCE-AMT * WS-FX-RATE.

       2000-APPLY-SPREAD.
           COMPUTE WS-SPREAD-FEE =
               WS-GROSS-CONVERTED * WS-SPREAD-PCT.

       3000-CALC-COMMISSION.
           COMPUTE WS-COMMISSION-FEE = WS-SOURCE-AMT * 0.005.
           IF WS-COMMISSION-FEE < WS-COMMISSION-MIN
               MOVE WS-COMMISSION-MIN TO WS-COMMISSION-FEE
           END-IF.

       4000-FINALIZE-ORDER.
           COMPUTE WS-NET-DELIVERED = WS-GROSS-CONVERTED -
               WS-SPREAD-FEE - WS-COMMISSION-FEE.
