       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYROLL-SALARY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-BASE-SALARY        PIC 9(6)V99 VALUE 008000.00.
       01 WS-OVERTIME-HOURS     PIC 9(03)   VALUE 015.
       01 WS-HOURLY-RATE        PIC 9(3)V99 VALUE 050.00.
       01 WS-PENSION-PCT        PIC 9(1)V4  VALUE 0.0976.
       01 WS-HEALTH-PCT         PIC 9(1)V4  VALUE 0.0900.
       01 WS-OVERTIME-PAY       PIC 9(5)V99 VALUE 0.00.
       01 WS-GROSS-TOTAL        PIC 9(6)V99 VALUE 0.00.
       01 WS-PENSION-DEDUCT     PIC 9(5)V99 VALUE 0.00.
       01 WS-HEALTH-DEDUCT      PIC 9(5)V99 VALUE 0.00.
       01 WS-TOTAL-DEDUCTIONS   PIC 9(5)V99 VALUE 0.00.
       01 WS-NET-SALARY         PIC 9(6)V99 VALUE 0.00.

       PROCEDURE DIVISION.
       0000-PROCESS-PAYROLL.
           PERFORM 1000-CALC-OVERTIME.
           PERFORM 2000-CALC-GROSS.
           PERFORM 3000-CALC-DEDUCTIONS.
           PERFORM 4000-CALC-NET.
           STOP RUN.

       1000-CALC-OVERTIME.
           IF WS-OVERTIME-HOURS > 0
               COMPUTE WS-OVERTIME-PAY =
                   WS-OVERTIME-HOURS * WS-HOURLY-RATE * 1.5
           ELSE
               MOVE 0.00 TO WS-OVERTIME-PAY
           END-IF.

       2000-CALC-GROSS.
           COMPUTE WS-GROSS-TOTAL =
               WS-BASE-SALARY + WS-OVERTIME-PAY.

       3000-CALC-DEDUCTIONS.
           COMPUTE WS-PENSION-DEDUCT =
               WS-GROSS-TOTAL * WS-PENSION-PCT.
           COMPUTE WS-HEALTH-DEDUCT =
               WS-GROSS-TOTAL * WS-HEALTH-PCT.
           COMPUTE WS-TOTAL-DEDUCTIONS =
               WS-PENSION-DEDUCT + WS-HEALTH-DEDUCT.

       4000-CALC-NET.
           COMPUTE WS-NET-SALARY =
               WS-GROSS-TOTAL - WS-TOTAL-DEDUCTIONS.
